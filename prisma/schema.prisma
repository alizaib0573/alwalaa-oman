generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PropertyType {
  APARTMENT
  VILLA
  TOWNHOUSE
  PENTHOUSE
  DUPLEX
  STUDIO
  COMMERCIAL
  LAND
  OFFICE
  RETAIL
}

enum PropertyStatus {
  OFF_PLAN
  UNDER_CONSTRUCTION
  READY_TO_MOVE
  FOR_SALE
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  AGENT
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvestmentGrade {
  A
  B
  C
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String     @unique
  passwordHash String
  role         UserRole   @default(AGENT)
  status       UserStatus @default(PENDING)
  isActive     Boolean    @default(true)
  agent        Agent?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  @@map("users")
}

model Community {
  id          String     @id
  slug        String     @unique
  name        String
  description String?    @db.Text
  location    String
  imageUrl    String?
  featured    Boolean    @default(false)
  metadata    Json?
  properties  Property[]
  createdAt   DateTime   @default(now())
  @@map("communities")
}

model Agent {
  id         String     @id
  slug       String     @unique
  userId     String     @unique @db.Uuid
  user       User       @relation(fields: [userId], references: [id])
  fullName   String
  phone      String
  bio        String?    @db.Text
  avatarUrl  String?
  isActive   Boolean    @default(true)
  properties Property[]
  createdAt  DateTime   @default(now())
  @@map("agents")
}

model Property {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String            @unique
  title       String
  description String            @db.Text
  type        PropertyType
  status      PropertyStatus
  city        String
  location    String
  community   Community         @relation(fields: [communityId], references: [id])
  communityId String
  agent       Agent             @relation(fields: [agentId], references: [id])
  agentId     String
  price       Decimal           @db.Decimal(12, 2)
  currency    String            @default("OMR")
  bedrooms    Int?
  bathrooms   Int?
  areaSqm     Decimal?          @db.Decimal(10, 2)
  gallery     String[]
  bannerImageUrl String?
  amenities   String[]
  coordinates Json?
  featured    Boolean           @default(false)
  metrics     InvestmentMetric?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt @default(now())
  leads       Lead[]
  @@map("properties")
}

model InvestmentMetric {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  property            Property        @relation(fields: [propertyId], references: [id])
  propertyId          String          @unique @db.Uuid
  expectedRentalYield  Decimal?        @db.Decimal(5, 2)
  roiProjection        Decimal?        @db.Decimal(5, 2)
  paymentPlanDetails   String?         @db.Text
  investmentGrade      InvestmentGrade?
  lastUpdated          DateTime        @default(now())
  @@map("investment_metrics")
}

model Lead {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  email       String
  phone       String
  propertyId String?   @db.Uuid
  property    Property? @relation(fields: [propertyId], references: [id])
  message     String   @db.Text
  status      LeadStatus @default(NEW)
  createdAt   DateTime @default(now())
  @@map("leads")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  ARCHIVED
}
